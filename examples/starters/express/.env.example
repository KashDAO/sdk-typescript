# Your Kash API key — kash_test_… for staging, kash_live_… for production.
# The SDK auto-routes to the right base URL from the prefix.
KASH_API_KEY=kash_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret (issue / rotate via kash.webhooks.rotateSecret()).
KASH_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server port.
PORT=3000
